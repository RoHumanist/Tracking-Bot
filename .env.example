# .env.example → 복사 후 .env로 저장하고 실제 값 입력
# cp .env.example .env

# ── 필수 ─────────────────────────────────────
# Anthropic Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ── 텔레그램 자동 수집 (--auto 모드) ─────────
# my.telegram.org → API development tools → 발급
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+821012345678

# 수집할 채널 목록 (쉼표 구분, username 또는 chat_id)
TELEGRAM_CHANNELS=channel_username1,channel_username2,-1001234567890

# 수집 시간 범위 (시간, 기본 24)
TELEGRAM_HOURS_BACK=24

# ── Slack ─────────────────────────────────────
# Slack App → Incoming Webhooks → 웹훅 URL 생성
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
SLACK_CHANNEL=#daily-briefing

# ── Notion ────────────────────────────────────
# Notion → Settings → Integrations → 새 integration 생성
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브리핑을 넣을 Notion 페이지 ID (URL에서 추출: notion.so/.../{PAGE_ID})
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 출력 설정 ─────────────────────────────────
OUTPUT_DIR=./output
SAVE_RAW_MESSAGES=true
SAVE_JSON_RESULT=true

# ── Claude 모델 설정 ──────────────────────────
CLAUDE_MODEL=claude-opus-4-5
CLAUDE_MAX_TOKENS=4096
